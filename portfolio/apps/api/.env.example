# Copy to .env and fill in real values. Never commit the filled-in .env.

PORT=5000

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,https://sana-portfolio-weld.vercel.app

# SMTP credentials used to send contact-form emails.
# If left unset, submissions are logged to the server console instead of emailed
# (useful for local development without real credentials).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=
