{
  "buildCommand": "npm run build --workspace=apps/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "apps/web/api/contact.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/apps/web/api/contact"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/apps/web/dist/index.html"
    }
  ]
}